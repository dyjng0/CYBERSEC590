# Copy to .env (or run: uv run lab.py init). Add your own keys; never share .env.
# Select ollama or duke. Only the selected provider's key is used.
MODEL_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
DUKE_API_KEY=
DUKE_MODEL=gpt-4.1-mini

# Project keys for the tracing exercise. Keys alone do not implement tracing.
# Paste the plain URL, without Markdown brackets or backslashes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
CHAT_TIMEOUT_SECONDS=90
